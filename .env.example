# Copy to .env and adjust. Real environment variables take precedence over this file.

# Web server
INVOICE_HOST=127.0.0.1
INVOICE_PORT=8000

# Folders (relative to the project folder unless absolute)
INVOICE_UPLOAD_DIR=uploads
INVOICE_OUTPUT_DIR=outputs
INVOICE_VENDOR_RULES_FILE=vendor_rules.json

# Batch limits. Files are stored one at a time, so a large batch costs processing time and
# disk space rather than memory. Roughly 0.1 s per invoice, so 5000 takes a few minutes.
INVOICE_MAX_FILES_PER_BATCH=5000
INVOICE_MAX_FILE_SIZE_MB=50

# A page needs at least this many letters/digits of real text, otherwise it is flagged
# SCANNED_OR_UNREADABLE_NO_OCR
INVOICE_MIN_TEXT_CHARS_PER_PAGE=20

# Allowed rounding difference when checking Taxable Value + taxes against Total Amount
INVOICE_AMOUNT_TOLERANCE=1.00

# Read numeric dates like 04/05/2024 as day/month/year (Indian convention)
INVOICE_DATE_DAYFIRST=true

# Delete uploaded PDFs from disk after a batch has been processed
INVOICE_DELETE_UPLOADS_AFTER_PROCESSING=true
